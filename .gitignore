# --- Never commit: retail ROM, BIOS dump, extracted ROM data, upstream source ---
# The ROM and BIOS are the player's own dumps. They are hash-gated build
# inputs, never redistributed, never committed.
*.gba
*.gbc
*.gb
baserom.gba
bios.bin
gba_bios.bin
*.bios
roms/
bios/
third_party/
extracted/
*.sav
saves/

# --- Generated code (ROM-derived, regenerated by each builder) ---
generated/
variants/*/generated/
*.elf
*.map

# --- Android / Gradle build outputs ---
build/
.gradle/
local.properties
*.apk
*.aab
*.so
app/build/

# --- CMake / native build ---
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# --- IDE / OS ---
.idea/
*.iml
.DS_Store
Thumbs.db
